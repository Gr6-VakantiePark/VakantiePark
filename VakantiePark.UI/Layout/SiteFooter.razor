@inject IParkService ParkService

<footer class="site-footer">
    <div class="container site-footer__grid">
        <div>
            <img class="site-footer__logo" src="img/logo.png" alt="Vakantiepark D’r op Uut" width="923" height="893">
        </div>
        <div>
            <h2>Verblijven</h2>
            <ul>
                <li><a href="accommodaties#holiday-homes">Vakantiehuizen</a></li>
                <li><a href="accommodaties#camping">Kampeerplaatsen</a></li>
                <li><a href="zoek-en-boek">Zoek en boek</a></li>
            </ul>
        </div>
        <div>
            <h2>Op het park</h2>
            <ul>
                <li><a href="zwembad">Zwembad</a></li>
                <li><a href="#zones">Zones</a></li>
            </ul>
        </div>
        <div>
            <h2>Contact</h2>
            <ul>
                @if (_park != null)
                {
                    <li><a href="@Formatting.PhoneLink(_park.PhoneNumber)">@_park.PhoneNumber</a></li>
                    <li><a href="mailto:@_park.Email">@_park.Email</a></li>
                }
                <li><a href="contact">Contactformulier</a></li>
                <li><a href="beheer/inloggen">Inloggen voor medewerkers</a></li>
            </ul>
        </div>
    </div>
    <div class="site-footer__bottom">
        <div class="container">Vakantiepark D’r op Uut. Voorbeeldtemplate voor onderwijsdoeleinden.</div>
    </div>
</footer>

@code {
    private ParkInfoDto? _park;

    protected override async Task OnInitializedAsync()
    {
        var response = await ParkService.GetInfoAsync();
        if (response.Succeeded)
        {
            _park = response.Value;
        }
    }
}
