@inject NavigationManager Navigation

<LoadingIndicator Text="Je wordt doorgestuurd naar het inloggen…" />

@code {
    protected override void OnInitialized()
    {
        string returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"beheer/inloggen?terug={Uri.EscapeDataString(returnUrl)}", replace: true);
    }
}
