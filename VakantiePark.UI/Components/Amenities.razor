<h2>Voorzieningen</h2>
<h3>Altijd aanwezig</h3>
<CheckList Items="AlwaysItems" />

@if (Type.PartialAmenities.Count > 0)
{
    <h3>Bij een deel van de @UnitsLabel</h3>
    <p class="note">Welke @UnitsLabel dit hebben, zie je bij het zoeken en boeken.</p>
    <CheckList Partial="true" Items="PartialItems" />
}

@code {
    [Parameter, EditorRequired]
    public AccommodationType Type { get; set; } = default!;

    private IEnumerable<CheckListItem> AlwaysItems =>
        Type.Amenities.Select(amenity => new CheckListItem(amenity));

    private IEnumerable<CheckListItem> PartialItems =>
        Type.PartialAmenities.Select(amenity => new CheckListItem(amenity.Name, $"{amenity.UnitCount} van {Type.UnitCount}"));

    private string UnitsLabel => Type.Category == AccommodationCategory.HolidayHome ? "huizen" : "plaatsen";
}
