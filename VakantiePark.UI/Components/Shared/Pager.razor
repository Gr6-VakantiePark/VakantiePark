@namespace VakantiePark.UI.Components
@if (TotalPages > 1)
{
    <nav class="pager" aria-label="Pagina’s met zoekresultaten">
        <ul>
            <li>
                @if (Current > 1)
                {
                    <a class="pager__step" href="@Url(Current - 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Vorige</a>
                }
                else
                {
                    <span class="pager__step pager__step--disabled"><i class="bi bi-chevron-left" aria-hidden="true"></i> Vorige</span>
                }
            </li>

            @foreach (int? number in Numbers())
            {
                <li>
                    @if (number is null)
                    {
                        <span class="pager__gap" aria-hidden="true">…</span>
                    }
                    else if (number == Current)
                    {
                        <span class="pager__page pager__page--current" aria-current="page">@number</span>
                    }
                    else
                    {
                        <a class="pager__page" href="@Url(number.Value)" aria-label="Pagina @number">@number</a>
                    }
                </li>
            }

            <li>
                @if (Current < TotalPages)
                {
                    <a class="pager__step" href="@Url(Current + 1)">Volgende <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                }
                else
                {
                    <span class="pager__step pager__step--disabled">Volgende <i class="bi bi-chevron-right" aria-hidden="true"></i></span>
                }
            </li>
        </ul>
    </nav>
}

@code {
    private const int Neighbours = 2;

    [Parameter, EditorRequired]
    public int Current { get; set; }

    [Parameter, EditorRequired]
    public int TotalPages { get; set; }

    [Parameter, EditorRequired]
    public Func<int, string> Url { get; set; } = _ => string.Empty;

    private IEnumerable<int?> Numbers()
    {
        int from = Math.Max(2, Current - Neighbours);
        int to = Math.Min(TotalPages - 1, Current + Neighbours);

        yield return 1;
        if (from > 2) yield return null;
        for (int page = from; page <= to; page++) yield return page;
        if (to < TotalPages - 1) yield return null;
        yield return TotalPages;
    }
}
