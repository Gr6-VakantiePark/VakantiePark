@page "/zoek-en-boek"
@inject ISearchService SearchService
@inject HttpClient Http
@inject NavigationManager Navigation
@namespace VakantiePark.UI.Pages

<PageTitle>Zoek en boek | Vakantiepark D’r op Uut</PageTitle>
<HeadContent>
    <meta name="description" content="Zoek een vakantiehuis of kampeerplaats en boek je verblijf.">
</HeadContent>

<PageHeader Title="Zoek en boek" Intro="Kies je data en het aantal personen." />

<section class="section section--mist" aria-labelledby="heading-search">
    <div class="container">
        @if (_optionsError is not null)
        {
            <h2 id="heading-search">Zoek een verblijf</h2>
            <p class="search-message" role="alert">Het zoekformulier kon niet worden geladen: @_optionsError</p>
        }
        else if (_options is null)
        {
            <h2 id="heading-search">Zoek een verblijf</h2>
            <LoadingIndicator Text="Zoekformulier laden…" />
        }
        else
        {
            <SearchForm @ref="_searchForm" Options="_options" Current="_criteria" InitialType="TypeSlug" />
            @if (_criteria is null)
            {
                <p class="note search-hint">Kies je aankomst, vertrek en het aantal personen en klik op Zoeken.</p>
            }
        }
    </div>
</section>

@if (_options is not null && _criteria is not null)
{
    <section class="section" aria-labelledby="heading-results">
        <div class="container">
            <div class="section__header">
                <h2 id="heading-results">Resultaten</h2>
                <p>
                    @Formatting.Date(_criteria.Arrival) – @Formatting.Date(_criteria.Departure),
                    @_criteria.Nights @(_criteria.Nights == 1 ? "nacht" : "nachten"),
                    @_criteria.Persons @(_criteria.Persons == 1 ? "persoon" : "personen")
                </p>
            </div>

            @if (_errors.Count > 0)
            {
                <div class="search-message" role="alert">
                    <p><strong>De zoekcriteria zijn niet compleet of kloppen niet:</strong></p>
                    <ul>
                        @foreach (var error in _errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }
            else if (_apiError is not null)
            {
                <p class="search-message" role="alert">Het zoeken is mislukt: @_apiError</p>
            }
            else if (_results is null)
            {
                <LoadingIndicator Text="Beschikbare verblijven zoeken…" />
            }
            else if (_results.TotalCount == 0)
            {
                <div class="empty-state" role="status">
                    <h3>Geen verblijven beschikbaar</h3>
                    <p>
                        Er is geen verblijf vrij van @Formatting.Date(_criteria.Arrival) tot @Formatting.Date(_criteria.Departure)
                        voor @_criteria.Persons @(_criteria.Persons == 1 ? "persoon" : "personen")@(_criteria.HasFilters ? " met de gekozen filters" : string.Empty).
                        Probeer andere data, minder personen of minder filters.
                    </p>
                    <div class="empty-state__actions">
                        <button class="button" type="button" @onclick="FocusSearchFormAsync">Terug naar het zoekformulier</button>
                        @if (_criteria.HasFilters)
                        {
                            <a class="button button--outline" href="@SearchUrl.For(_criteria.WithoutFilters())">Zoek zonder filters</a>
                        }
                    </div>
                </div>
            }
            else if (_results.Items.Count == 0)
            {
                <div class="empty-state" role="status">
                    <h3>Deze pagina bestaat niet</h3>
                    <p>Er zijn @_results.TotalPages pagina’s met resultaten.</p>
                    <div class="empty-state__actions">
                        <a class="button" href="@PageUrl(1)">Naar de eerste pagina</a>
                    </div>
                </div>
            }
            else
            {
                <div class="results-toolbar">
                    <p class="count" role="status">
                        @_results.TotalCount @(_results.TotalCount == 1 ? "verblijf" : "verblijven") beschikbaar@(_results.TotalPages > 1 ? $", je ziet {_results.First} – {_results.Last}" : string.Empty)
                    </p>
                    <div class="results-toolbar__sort">
                        <label for="sort">Sorteren op</label>
                        <select id="sort" value="@SortValue(_criteria.OrderBy, _criteria.OrderType)" @onchange="OnSortChanged">
                            @foreach (var orderBy in Enum.GetValues<AccommodationOrderBy>())
                            {
                                @foreach (var orderType in SortDirections)
                                {
                                    <option value="@SortValue(orderBy, orderType)">@Label(orderBy) (@(orderType == OrderType.Ascending ? "oplopend" : "aflopend"))</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <ul class="results">
                    @foreach (var accommodation in _results.Items)
                    {
                        <SearchResultCard @key="accommodation.Id" Accommodation="accommodation" Nights="_criteria.Nights" PhotoUrl="@PhotoUrl(accommodation.MainPhoto)" BookUrl="@BookingQuery.For(accommodation.Id, _criteria)" />
                    }
                </ul>

                <Pager Current="_results.PageNumber" TotalPages="_results.TotalPages" Url="PageUrl" />
            }
        </div>
    </section>
}

@code {
    private static readonly OrderType[] SortDirections = [OrderType.Ascending, OrderType.Descending];

    [SupplyParameterFromQuery(Name = "aankomst")] public string? ArrivalValue { get; set; }
    [SupplyParameterFromQuery(Name = "vertrek")] public string? DepartureValue { get; set; }
    [SupplyParameterFromQuery(Name = "personen")] public int? PersonsValue { get; set; }
    [SupplyParameterFromQuery(Name = "kleine-kinderen")] public int? YoungChildrenValue { get; set; }
    [SupplyParameterFromQuery(Name = "soort")] public string? CategoryValue { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? TypeSlug { get; set; }
    [SupplyParameterFromQuery(Name = "huisdieren")] public int? PetsValue { get; set; }
    [SupplyParameterFromQuery(Name = "voorzieningen")] public string? AmenitiesValue { get; set; }
    [SupplyParameterFromQuery(Name = "sorteren")] public string? OrderByValue { get; set; }
    [SupplyParameterFromQuery(Name = "volgorde")] public string? OrderTypeValue { get; set; }
    [SupplyParameterFromQuery(Name = "pagina")] public int? PageValue { get; set; }

    private SearchOptionsDto? _options;
    private string? _optionsError;
    private AccommodationSearchCriteria? _criteria;
    private PaginatedResult<AccommodationDetailDto>? _results;
    private string? _apiError;
    private SearchForm? _searchForm;
    private readonly List<string> _errors = new();

    protected override async Task OnInitializedAsync()
    {
        var response = await SearchService.GetSearchOptionsAsync();
        if (response.Succeeded && response.Value is not null)
            _options = response.Value;
        else
            _optionsError = string.IsNullOrWhiteSpace(response.Message) ? "onbekende fout." : response.Message;
    }

    protected override async Task OnParametersSetAsync()
    {
        _errors.Clear();
        _results = null;
        _apiError = null;
        _criteria = null;

        if (ArrivalValue is null && DepartureValue is null && PersonsValue is null)
            return;

        _criteria = ReadCriteria();
        if (_errors.Count > 0)
            return;

        var response = await SearchService.SearchAsync(_criteria);
        if (response.Succeeded)
            _results = response.Value ?? new() { PageNumber = _criteria.PageNumber, PageSize = _criteria.PageSize };
        else
            _apiError = string.IsNullOrWhiteSpace(response.Message) ? "onbekende fout." : response.Message;
    }

    private AccommodationSearchCriteria ReadCriteria()
    {
        var criteria = new AccommodationSearchCriteria();

        if (!DateOnly.TryParseExact(ArrivalValue, "yyyy-MM-dd", out var arrival))
        {
            _errors.Add("Kies een geldige aankomstdatum.");
        }
        else if (arrival < DateOnly.FromDateTime(DateTime.Today))
        {
            _errors.Add("De aankomstdatum mag niet in het verleden liggen.");
        }
        criteria.Arrival = arrival;

        if (!DateOnly.TryParseExact(DepartureValue, "yyyy-MM-dd", out var departure))
        {
            _errors.Add("Kies een geldige vertrekdatum.");
        }
        criteria.Departure = departure;

        if (arrival != default && departure != default && departure <= arrival)
        {
            _errors.Add("De vertrekdatum moet na de aankomstdatum liggen.");
        }

        if (PersonsValue is null or < 1)
        {
            _errors.Add("Kies minimaal 1 persoon.");
        }
        criteria.Persons = PersonsValue ?? 0;

        if (YoungChildrenValue is < 0)
        {
            _errors.Add("Het aantal kinderen kan niet negatief zijn.");
        }
        else if (YoungChildrenValue >= criteria.Persons && criteria.Persons > 0)
        {
            _errors.Add("Er moet minimaal 1 persoon meegaan die geen klein kind is.");
        }
        criteria.YoungChildren = YoungChildrenValue ?? 0;

        if (PetsValue is < 0)
        {
            _errors.Add("Het aantal huisdieren kan niet negatief zijn.");
        }
        criteria.Pets = PetsValue ?? 0;

        if (!string.IsNullOrWhiteSpace(CategoryValue))
        {
            criteria.Category = SearchUrl.CategoryFromSlug(CategoryValue);
            if (criteria.Category is null)
            {
                _errors.Add($"Onbekende soort verblijf ‘{CategoryValue}’.");
            }
        }

        criteria.Type = string.IsNullOrWhiteSpace(TypeSlug) ? null : TypeSlug;
        criteria.Amenities = string.IsNullOrWhiteSpace(AmenitiesValue) ? null : AmenitiesValue;

        if (OrderByValue is not null)
        {
            if (SearchUrl.OrderByFromSlug(OrderByValue) is { } orderBy)
            {
                criteria.OrderBy = orderBy;
            }
            else
            {
                _errors.Add($"Op ‘{OrderByValue}’ kan niet gesorteerd worden.");
            }
        }

        if (OrderTypeValue is not null)
        {
            if (SearchUrl.OrderTypeFromSlug(OrderTypeValue) is { } orderType)
            {
                criteria.OrderType = orderType;
            }
            else
            {
                _errors.Add($"Onbekende sorteervolgorde ‘{OrderTypeValue}’.");
            }
        }

        if (PageValue is < 1)
        {
            _errors.Add("Het paginanummer moet minimaal 1 zijn.");
        }
        criteria.PageNumber = PageValue ?? 1;

        return criteria;
    }

    private async Task FocusSearchFormAsync()
    {
        if (_searchForm is not null)
            await _searchForm.FocusAsync();
    }

    private string PageUrl(int page) =>
        _criteria is null ? SearchUrl.Page : SearchUrl.For(_criteria.WithPage(page));

    private static string SortValue(AccommodationOrderBy orderBy, OrderType orderType) => $"{orderBy}:{orderType}";

    private static string Label(AccommodationOrderBy orderBy) =>
        typeof(AccommodationOrderBy).GetField(orderBy.ToString())?.GetCustomAttribute<DisplayAttribute>()?.GetName()
        ?? orderBy.ToString();

    private void OnSortChanged(ChangeEventArgs e)
    {
        if (_criteria is null || e.Value is not string value)
            return;

        var parts = value.Split(':');
        if (parts.Length == 2
            && Enum.TryParse<AccommodationOrderBy>(parts[0], out var orderBy)
            && Enum.TryParse<OrderType>(parts[1], out var orderType))
        {
            Navigation.NavigateTo(SearchUrl.For(_criteria.WithSorting(orderBy, orderType)));
        }
    }


    private string? PhotoUrl(string? path) =>
        string.IsNullOrWhiteSpace(path) || Http.BaseAddress is null ? null : new Uri(Http.BaseAddress, path).ToString();
}
