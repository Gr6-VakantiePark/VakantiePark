@page "/boeken"
@using VakantiePark.Shared.DTOs.Accommodations
@using VakantiePark.UI.Interfaces
@using VakantiePark.UI.Models
@using VakantiePark.UI.Services
@inject IBookingService BookingService
@inject BookingState BookingState
@inject NavigationManager Navigation
@namespace VakantiePark.UI.Pages

<PageTitle>Boeken | Vakantiepark D’r op Uut</PageTitle>
<HeadContent>
    <meta name="description" content="Vul je gegevens in en bevestig je boeking bij Vakantiepark D’r op Uut.">
</HeadContent>

<PageHeader Title="Boeken" Intro="@Intro" Crumbs="_crumbs" />

<section class="section">
    <div class="container">
        @if (_error is not null)
        {
            <div class="booking-message" role="alert">
                <h2>Deze boeking kan niet verder</h2>
                <p>@_error</p>
                <a class="button" href="zoek-en-boek">Naar zoek en boek</a>
            </div>
        }
        else if (_request is null || _accommodation is null)
        {
            <LoadingIndicator Text="Verblijf laden…" />
        }
        else if (_step == BookingStep.Details)
        {
            <div class="two-columns">
                <div class="booking-form">
                    <h2 id="heading-details">Jouw gegevens</h2>
                    <EditForm class="form" Model="_details" OnValidSubmit="ShowSummary" FormName="booking">
                        <DataAnnotationsValidator />
                        <div class="field">
                            <label for="name">Naam</label>
                            <InputText id="name" @bind-Value="_details.Name" autocomplete="name" maxlength="@BookingDetails.NameMaxLength" />
                            <ValidationMessage For="() => _details.Name" />
                        </div>
                        <div class="field">
                            <label for="email">E-mailadres</label>
                            <InputText id="email" type="email" @bind-Value="_details.Email" autocomplete="email" maxlength="@BookingDetails.EmailMaxLength" />
                            <ValidationMessage For="() => _details.Email" />
                        </div>
                        <div class="field">
                            <label for="phone">Telefoonnummer <span class="field__hint">Niet verplicht</span></label>
                            <InputText id="phone" type="tel" @bind-Value="_details.Phone" autocomplete="tel" maxlength="@BookingDetails.PhoneMaxLength" />
                            <ValidationMessage For="() => _details.Phone" />
                        </div>
                        <div><button class="button" type="submit">Naar overzicht</button></div>
                    </EditForm>
                </div>
                <BookingSummary Request="_request" Accommodation="_accommodation" />
            </div>
        }
        else
        {
            <div class="booking-overview">
                <p class="lead">Controleer je gegevens. Klopt alles? Bevestig dan je boeking.</p>
                <BookingSummary Request="_request" Accommodation="_accommodation" Guest="_details.ToGuestDto()" Title="Overzicht van je boeking" />
                @if (_submitError is not null)
                {
                    <div class="booking-message" role="alert">
                        <h2>Je boeking is niet gelukt</h2>
                        <p>@_submitError</p>
                    </div>
                }
                <div class="booking-actions">
                    <button class="button button--outline" type="button" disabled="@_submitting" @onclick="EditDetails">Gegevens aanpassen</button>
                    <button class="button" type="button" disabled="@_submitting" @onclick="ConfirmAsync">@(_submitting ? "Bezig met boeken…" : "Boeking bevestigen")</button>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private enum BookingStep
    {
        Details,
        Summary
    }

    private static readonly IReadOnlyList<Breadcrumb> _crumbs = [new("Zoek en boek", "zoek-en-boek")];

    private BookingRequest? _request;
    private AccommodationDetailDto? _accommodation;
    private string? _error;
    private BookingDetails _details = new();
    private BookingStep _step = BookingStep.Details;
    private bool _submitting;
    private string? _submitError;

    [SupplyParameterFromQuery(Name = BookingQuery.Accommodation)]
    public string? AccommodationValue { get; set; }

    [SupplyParameterFromQuery(Name = BookingQuery.Arrival)]
    public string? ArrivalValue { get; set; }

    [SupplyParameterFromQuery(Name = BookingQuery.Departure)]
    public string? DepartureValue { get; set; }

    [SupplyParameterFromQuery(Name = BookingQuery.Persons)]
    public string? PersonsValue { get; set; }

    [SupplyParameterFromQuery(Name = BookingQuery.Pets)]
    public string? PetsValue { get; set; }

    private string Intro => _step == BookingStep.Details
        ? "Stap 1 van 2: vul je gegevens in."
        : "Stap 2 van 2: controleer en bevestig je boeking.";

    protected override async Task OnParametersSetAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (!BookingQuery.TryParse(AccommodationValue, ArrivalValue, DepartureValue, PersonsValue, PetsValue, today, out var request, out var error))
        {
            _request = null;
            _accommodation = null;
            _error = error;
            return;
        }

        if (request == _request && _accommodation is not null)
            return;

        _request = request;
        _accommodation = null;
        _error = null;
        _step = BookingStep.Details;

        var response = await BookingService.GetStayAsync(request!);
        if (!response.Succeeded || response.Value is null)
        {
            _error = string.IsNullOrWhiteSpace(response.Message) ? "Dit verblijf kon niet worden geladen." : response.Message;
            return;
        }

        _error = BookingQuery.CheckAgainst(request!, response.Value);
        if (_error is not null)
            return;

        var availability = await BookingService.CheckAvailabilityAsync(request!);
        if (!availability.Succeeded)
        {
            _error = string.IsNullOrWhiteSpace(availability.Message) ? "Dit verblijf is niet beschikbaar in deze periode." : availability.Message;
            return;
        }

        _accommodation = response.Value;
    }

    private void ShowSummary()
    {
        _submitError = null;
        _step = BookingStep.Summary;
    }

    private void EditDetails()
    {
        _submitError = null;
        _step = BookingStep.Details;
    }

    private async Task ConfirmAsync()
    {
        if (_request is null || _accommodation is null || _submitting)
            return;

        if (_accommodation.Price is not { } price)
        {
            _submitError = "De prijs van dit verblijf is nog niet bekend. Neem contact op met de receptie.";
            return;
        }

        _submitting = true;
        _submitError = null;

        var response = await BookingService.CreateAsync(_request, _details.ToGuestDto(), price.Total);
        if (response.Succeeded && response.Value is not null)
        {
            BookingState.Confirm(response.Value, _request, _accommodation);
            Navigation.NavigateTo("boeken/bevestiging");
            return;
        }

        _submitError = string.IsNullOrWhiteSpace(response.Message) ? "Je boeking kon niet worden opgeslagen. Probeer het opnieuw." : response.Message;
        await RefreshStayAsync();
        _submitting = false;
    }

    private async Task RefreshStayAsync()
    {
        var stay = await BookingService.GetStayAsync(_request!);
        if (stay.Succeeded && stay.Value is not null)
            _accommodation = stay.Value;
    }
}
