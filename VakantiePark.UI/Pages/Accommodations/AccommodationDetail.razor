@page "/accommodaties/{Slug}"
@inject ISearchService SearchService
@namespace VakantiePark.UI.Pages

@if (_isLoading)
{
    <PageTitle>Accommodatie laden | Vakantiepark D’r op Uut</PageTitle>

    <section class="section">
        <div class="container">
            <LoadingIndicator Text="Accommodatie laden…" />
        </div>
    </section>
}
else if (_type is null)
{
    <PageTitle>Accommodatie niet gevonden | Vakantiepark D’r op Uut</PageTitle>

    <PageHeader Title="Accommodatie niet gevonden" Intro="@(_errorMessage ?? "Dit type accommodatie bestaat niet (meer).")" Crumbs="_crumbs" />

    <section class="section" aria-labelledby="heading-next">
        <div class="container">
            <h2 id="heading-next">Bekijk wat er wel is</h2>
            <p>In het overzicht vind je alle vakantiehuizen en kampeerplaatsen van het park.</p>
            <a class="button" href="accommodaties">Bekijk accommodaties</a>
        </div>
    </section>
}
else
{
    <PageTitle>@_type.Name | Vakantiepark D’r op Uut</PageTitle>
    <HeadContent>
        <meta name="description" content="@_type.Description">
    </HeadContent>

    <PageHeader Title="@_type.Name" Intro="@_type.Tagline" Crumbs="_crumbs" />

    <Gallery Images="_images" LastIsFloorPlan="_type.Category == AccommodationCategory.HolidayHome" />

    <section class="section">
        <div class="container detail">
            <div>
                <h2>Over de @_type.Name</h2>
                <p class="lead">@_type.Description</p>
                <KeyFacts Facts="_type.KeyFacts" />
                <Amenities Type="_type" />
            </div>
            <BookingCard Type="_type" />
        </div>
    </section>
}

@code {
    private static readonly IReadOnlyList<Breadcrumb> _crumbs = [new("Accommodaties", "accommodaties")];

    private AccommodationType? _type;
    private IReadOnlyList<GalleryImage> _images = [];
    private string? _errorMessage;
    private bool _isLoading = true;

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _type = null;
        _images = [];
        _errorMessage = null;

        try
        {
            var response = await SearchService.GetTypeAsync(Slug);
            if (!response.Succeeded || response.Value == null)
            {
                _errorMessage = string.IsNullOrWhiteSpace(response.Message) ? null : response.Message;
                return;
            }

            _type = response.Value.ToAccommodationType();
            _images = Enumerable.Range(1, 4)
                .Select(number => new GalleryImage($"img/photos/{_type.Slug}-{number}.jpg", ImageAlt(_type, number)))
                .ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Fout bij laden: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string ImageAlt(AccommodationType type, int number) =>
        type.Category == AccommodationCategory.HolidayHome && number == 4
            ? $"Plattegrond van de {type.Name}"
            : $"{type.Name}, foto {number}";
}
