@page "/accommodaties"
@inject ISearchService SearchService
@namespace VakantiePark.UI.Pages

<PageTitle>Accommodaties | Vakantiepark D’r op Uut</PageTitle>
<HeadContent>
    <meta name="description" content="Alle vakantiehuizen en kampeerplaatsen van Vakantiepark D’r op Uut.">
</HeadContent>

<PageHeader Title="Accommodaties" Intro="Kies een type om alle huizen of plaatsen van dat type te zien." />

@if (_error is not null)
{
    <section class="section" aria-labelledby="heading-error">
        <div class="container">
            <p id="heading-error" class="search-message" role="alert">De accommodaties konden niet worden geladen: @_error</p>
        </div>
    </section>
}
else if (!_loaded)
{
    <section class="section" aria-labelledby="heading-loading">
        <div class="container">
            <LoadingIndicator Text="Accommodaties laden…" />
        </div>
    </section>
}
else
{
    <section class="section" id="holiday-homes" aria-labelledby="heading-houses">
        <div class="container">
            <div class="section__header">
                <h2 id="heading-houses">Vakantiehuizen</h2>
                <p>@_holidayHomes.Sum(type => type.UnitCount) huizen in @_holidayHomes.Count types</p>
            </div>
            <TypeCardList Types="_holidayHomes" />
        </div>
    </section>

    <section class="section section--mist" id="camping" aria-labelledby="heading-camping">
        <div class="container">
            <div class="section__header">
                <h2 id="heading-camping">Kampeerplaatsen</h2>
                <p>@_campingPitches.Sum(type => type.UnitCount) plaatsen in @_campingPitches.Count types</p>
            </div>
            <TypeCardList Types="_campingPitches" />
        </div>
    </section>
}

@code {
    private List<AccommodationType> _holidayHomes = new();
    private List<AccommodationType> _campingPitches = new();
    private string? _error;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        var response = await SearchService.GetTypesAsync();
        if (!response.Succeeded || response.Value == null)
        {
            _error = string.IsNullOrWhiteSpace(response.Message) ? "onbekende fout." : response.Message;
            return;
        }

        var types = response.Value.Select(type => type.ToAccommodationType()).ToList();
        _holidayHomes = types.Where(type => type.Category == AccommodationCategory.HolidayHome).ToList();
        _campingPitches = types.Where(type => type.Category == AccommodationCategory.CampingPitch).ToList();
        _loaded = true;
    }
}
