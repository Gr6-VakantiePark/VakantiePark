@page "/"
@inject ISearchService SearchService
@inject IParkService ParkService

<PageTitle>Home | Vakantiepark D’r op Uut</PageTitle>
<HeadContent>
    <meta name="description" content="Vakantiehuizen en kampeerplaatsen tussen bos, heide en water.">
</HeadContent>

<section class="hero">
    <div class="container hero__grid">
        <div>
            <h1>Tussen bos, heide en water</h1>
            <p class="hero__intro">
                @if (!_isLoading && _error == null)
                {
                    @($"{_holidayHomes.Sum(type => type.UnitCount)} vakantiehuizen en {_campingPitches.Sum(type => type.UnitCount)} kampeerplaatsen, verdeeld over {_zones.Count} zones. ")
                }
                Met een overdekt zwembad midden in het park.
            </p>
            <div class="hero__actions">
                <a class="button" href="zoek-en-boek">Zoek en boek</a>
                <a class="button button--outline" href="accommodaties">Bekijk accommodaties</a>
            </div>
        </div>
        <img class="hero__image" src="img/photos/hero.jpg" alt="Uitzicht over het park" width="1600" height="1100">
    </div>
    <WaveDivider />
</section>

@if (_error != null)
{
    <section class="section" aria-labelledby="heading-error">
        <div class="container">
            <p id="heading-error" class="search-message" role="alert">De accommodaties konden niet worden geladen: @_error</p>
        </div>
    </section>
}
else if (_isLoading)
{
    <section class="section">
        <div class="container">
            <LoadingIndicator Text="Accommodaties laden…" />
        </div>
    </section>
}
else
{
    <section class="section" aria-labelledby="heading-houses">
        <div class="container">
            <div class="section__header">
                <h2 id="heading-houses">Vakantiehuizen</h2>
                <p>@PersonsRange(_holidayHomesDto)</p>
            </div>
            <TypeCardList Types="_holidayHomes" />
        </div>
    </section>

    <section class="section section--mist" aria-labelledby="heading-camping">
        <div class="container">
            <div class="section__header">
                <h2 id="heading-camping">Kamperen</h2>
                <p>Met tent, caravan of camper. @PersonsRange(_campingPitchesDto)</p>
            </div>
            <TypeCardList Types="_campingPitches" />
        </div>
    </section>

    <section class="section" id="zones" aria-labelledby="heading-zones">
        <div class="container">
            <div class="section__header">
                <h2 id="heading-zones">Het park in @_zones.Count zones</h2>
                <p class="zones__legend">
                    <span><span class="zone-dot zone-dot--houses"></span>Vakantiehuizen</span>
                    <span><span class="zone-dot zone-dot--camping"></span>Kampeerplaatsen</span>
                </p>
            </div>
            <ul class="zones">
                @foreach (var zone in _zones)
                {
                    var isCamping = AccommodationTypeMappings.ParseCategory(zone.Category) == AccommodationCategory.CampingPitch;
                    <li @key="zone.Name">
                        <h3><span class="zone-dot @(isCamping ? "zone-dot--camping" : "zone-dot--houses")"></span>@zone.Name</h3>
                        <p>@zone.UnitCount @(isCamping ? "kampeerplaatsen" : "vakantiehuizen")</p>
                    </li>
                }
            </ul>
        </div>
    </section>
}

<section class="section section--flush-top" aria-labelledby="heading-pool">
    <div class="container">
        <div class="feature">
            <div>
                <h2 id="heading-pool">Zwemmen, ook als het regent</h2>
                <p>Het overdekte zwembad heeft een wedstrijdbad, een peuterbad en een glijbaan. In de zomer is ook het buitenbad open.</p>
                <a class="button" href="zwembad">Naar het zwembad</a>
            </div>
            <dl>
                @if (_park != null)
                {
                    @foreach (var hour in _park.PoolHours.Where(hour => hour.ShowOnHome))
                    {
                        <div><dt>@hour.Label</dt><dd>@hour.Value</dd></div>
                    }
                }
                <div><dt>Toegang</dt><dd>Gratis voor gasten</dd></div>
            </dl>
        </div>
    </div>
</section>

@code {
    private List<AccommodationType> _holidayHomes = new();
    private List<AccommodationType> _campingPitches = new();
    private List<ZoneDto> _zones = new();
    private List<AccommodationTypeSummaryDto> _holidayHomesDto = new();
    private List<AccommodationTypeSummaryDto> _campingPitchesDto = new();
    private ParkInfoDto? _park;
    private string? _error;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var parkResponse = await ParkService.GetInfoAsync();
        if (parkResponse.Succeeded)
        {
            _park = parkResponse.Value;
        }

        try
        {
            var typesResponse = await SearchService.GetTypesAsync();
            if (!typesResponse.Succeeded || typesResponse.Value == null)
            {
                _error = string.IsNullOrWhiteSpace(typesResponse.Message) ? "onbekende fout." : typesResponse.Message;
                return;
            }

            var zonesResponse = await SearchService.GetZonesAsync();
            if (!zonesResponse.Succeeded || zonesResponse.Value == null)
            {
                _error = string.IsNullOrWhiteSpace(zonesResponse.Message) ? "onbekende fout." : zonesResponse.Message;
                return;
            }

            _holidayHomesDto = typesResponse.Value
                .Where(type => AccommodationTypeMappings.ParseCategory(type.Category) == AccommodationCategory.HolidayHome)
                .ToList();
            _campingPitchesDto = typesResponse.Value
                .Where(type => AccommodationTypeMappings.ParseCategory(type.Category) == AccommodationCategory.CampingPitch)
                .ToList();

            var types = typesResponse.Value.Select(type => type.ToAccommodationType()).ToList();
            _holidayHomes = types.Where(type => type.Category == AccommodationCategory.HolidayHome).ToList();
            _campingPitches = types.Where(type => type.Category == AccommodationCategory.CampingPitch).ToList();
            _zones = zonesResponse.Value;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string PersonsRange(List<AccommodationTypeSummaryDto> types)
    {
        if (types.Count == 0)
        {
            return string.Empty;
        }

        return $"Voor {types.Min(type => type.MinPersons)} tot {types.Max(type => type.MaxPersons)} personen.";
    }
}
