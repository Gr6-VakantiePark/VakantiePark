@page "/zwembad"
@inject IParkService ParkService
@namespace VakantiePark.UI.Pages

<PageTitle>Zwembad | Vakantiepark D’r op Uut</PageTitle>
<HeadContent>
    <meta name="description" content="Openingstijden en baden van het zwembad.">
</HeadContent>

<PageHeader Title="Het zwembad" Intro="Overdekt zwemmen midden in het park, gratis voor gasten." />

<Gallery Images="_images" />

<section class="section">
    <div class="container two-columns">
        <div>
            <h2>Openingstijden</h2>
            @if (_park != null)
            {
                <dl class="hours">
                    @foreach (var hour in _park.PoolHours)
                    {
                        <div><dt>@hour.Label</dt><dd>@hour.Value</dd></div>
                    }
                </dl>
            }
            else if (_error != null)
            {
                <p class="search-message" role="alert">De openingstijden konden niet worden geladen: @_error</p>
            }
            else
            {
                <LoadingIndicator Text="Openingstijden laden…" />
            }
            <p>Toegang is gratis voor gasten van het park. Neem je parkpas mee naar de ingang.</p>
        </div>
        <div>
            <h2>Goed om te weten</h2>
            <CheckList Items="_goodToKnow" />
            @if (_park != null && _park.AccommodationsNearPool > 0)
            {
                <p>Wil je dichtbij logeren? @_park.AccommodationsNearPool accommodaties liggen dicht bij het zwembad. Je kunt hierop filteren bij <a href="zoek-en-boek">zoek en boek</a>.</p>
            }
        </div>
    </div>
</section>

<section class="section section--mist" aria-labelledby="heading-pools">
    <div class="container">
        <div class="section__header">
            <h2 id="heading-pools">De baden</h2>
        </div>
        @if (_park != null)
        {
            <ul class="pools">
                @foreach (var basin in _park.PoolBasins)
                {
                    <li class="pool" @key="basin.Name">
                        <h3>@basin.Name</h3>
                        <p>@basin.Description</p>
                        <p class="pool__size">@basin.Size</p>
                    </li>
                }
            </ul>
        }
        else if (_error == null)
        {
            <LoadingIndicator Text="Baden laden…" />
        }
    </div>
</section>

@code {
    private static readonly IReadOnlyList<GalleryImage> _images =
    [
        new("img/photos/pool-1.jpg", "Het binnenbad"),
        new("img/photos/pool-2.jpg", "Het recreatiebad"),
        new("img/photos/pool-3.jpg", "Het buitenbad")
    ];

    private static readonly IReadOnlyList<CheckListItem> _goodToKnow =
    [
        new("Kinderen zonder zwemdiploma zwemmen onder begeleiding van een volwassene"),
        new("Er is altijd een badmeester aanwezig"),
        new("Kleedhokjes en kluisjes zijn gratis"),
        new("Het zwembad is rolstoeltoegankelijk, met een tillift bij het wedstrijdbad"),
        new("Huisdieren mogen niet in het zwembad")
    ];

    private ParkInfoDto? _park;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var response = await ParkService.GetInfoAsync();
        if (response.Succeeded && response.Value != null)
        {
            _park = response.Value;
        }
        else
        {
            _error = string.IsNullOrWhiteSpace(response.Message) ? "onbekende fout." : response.Message;
        }
    }
}
