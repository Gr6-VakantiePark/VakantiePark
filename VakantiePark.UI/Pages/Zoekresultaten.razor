@page "/zoekresultaten"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Reflection
@using VakantiePark.Shared.Common
@using VakantiePark.Shared.DTOs.Accommodaties
@using VakantiePark.UI.Components
@using VakantiePark.UI.Interfaces
@inject IZoekService ZoekService
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Zoek &amp; boek | Vakantiepark D'r op Uut</PageTitle>

<h1>Zoek &amp; boek</h1>

@if (optiesFout is not null)
{
    <div class="alert alert-danger" role="alert">
        De zoekopties konden niet worden geladen: @optiesFout
    </div>
}
else if (opties is null)
{
    <Laadindicator Tekst="Zoekformulier laden..." />
}
else
{
    <ZoekFormulier Opties="opties" Huidig="criteria" />

    @if (criteria is null)
    {
        <p class="text-muted">Kies je aankomst, vertrek en het aantal personen en klik op <strong>Zoeken</strong>.</p>
    }
    else if (fouten.Count > 0)
    {
        <div class="alert alert-warning" role="alert">
            <strong>De zoekcriteria zijn niet compleet of kloppen niet:</strong>
            <ul class="mb-0">
                @foreach (var fout in fouten)
                {
                    <li>@fout</li>
                }
            </ul>
        </div>
    }
    else if (apiFout is not null)
    {
        <div class="alert alert-danger" role="alert">
            Het zoeken is mislukt: @apiFout
        </div>
    }
    else if (resultaten is null)
    {
        <Laadindicator Tekst="Beschikbare verblijven zoeken..." />
    }
    else
    {
        <h2 class="h4">Resultaten</h2>
        <p class="text-muted">
            Van @Datum(criteria.Aankomst) tot @Datum(criteria.Vertrek) (@criteria.AantalNachten @(criteria.AantalNachten == 1 ? "nacht" : "nachten")),
            @criteria.Personen @(criteria.Personen == 1 ? "persoon" : "personen").
        </p>

        @if (resultaten.TotalCount == 0)
        {
            <div class="alert alert-warning" role="status">
                <h3 class="h5 alert-heading">Geen verblijven beschikbaar</h3>
                <p>
                    Er is geen verblijf vrij van @Datum(criteria.Aankomst) tot @Datum(criteria.Vertrek)
                    voor @criteria.Personen @(criteria.Personen == 1 ? "persoon" : "personen")@(criteria.HeeftFilters ? " met de gekozen filters" : "").
                </p>
                <p class="mb-0">Probeer andere data, minder personen of minder filters.</p>
                <hr />
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary" href="@FormulierUrl">Terug naar het zoekformulier</a>
                    @if (criteria.HeeftFilters)
                    {
                        <a class="btn btn-outline-secondary" href="zoekresultaten?@criteria.ZonderFilters().ToQueryString()">Zoek zonder filters</a>
                    }
                </div>
            </div>
        }
        else if (resultaten.Items.Count == 0)
        {
            <div class="alert alert-info" role="status">
                Pagina @resultaten.PageNumber bestaat niet; er zijn @resultaten.TotalPages pagina's.
                <a href="@PaginaUrl(1)">Ga naar de eerste pagina</a>.
            </div>
        }
        else
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <p role="status" class="mb-0">
                    @resultaten.TotalCount @(resultaten.TotalCount == 1 ? "verblijf" : "verblijven") beschikbaar.
                    @if (resultaten.TotalPages > 1)
                    {
                        <span>Je ziet @resultaten.First–@resultaten.Last (pagina @resultaten.PageNumber van @resultaten.TotalPages).</span>
                    }
                </p>
                <div class="d-flex align-items-center gap-2">
                    <label for="sortering" class="form-label mb-0 text-nowrap">Sorteren op</label>
                    <select id="sortering" class="form-select form-select-sm" value="@SorteerWaarde(criteria.OrderBy, criteria.OrderType)" @onchange="SorteringGewijzigd">
                        @foreach (var orderBy in Enum.GetValues<AccommodatieOrderBy>())
                        {
                            @foreach (var orderType in new[] { OrderType.Ascending, OrderType.Descending })
                            {
                                <option value="@SorteerWaarde(orderBy, orderType)">@Label(orderBy) (@(orderType == OrderType.Ascending ? "oplopend" : "aflopend"))</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                @foreach (var v in resultaten.Items)
                {
                    <div class="col">
                        <article class="card h-100">
                            <img src="@AfbeeldingUrl(v.Hoofdafbeelding)" class="card-img-top" alt="Foto van @v.Type"
                                 onerror="this.onerror=null;this.src='@Placeholder'" />
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <h2 class="h5 card-title mb-1">@v.Naam</h2>
                                    <span class="badge text-bg-secondary">@v.Categorie</span>
                                </div>
                                <p class="text-muted mb-3">@v.Type · @v.Zone · <small>@v.Code</small></p>

                                <dl class="row small mb-3">
                                    <dt class="col-6">Max. personen</dt>
                                    <dd class="col-6">@v.MaxPersonen</dd>

                                    @if (v.Slaapkamers is not null)
                                    {
                                        <dt class="col-6">Slaapkamers</dt>
                                        <dd class="col-6">@v.Slaapkamers</dd>
                                        <dt class="col-6">Badkamers</dt>
                                        <dd class="col-6">@v.Badkamers</dd>
                                        <dt class="col-6">Bedden</dt>
                                        <dd class="col-6">@v.Bedden</dd>
                                    }

                                    @if (v.Ondergrond is not null)
                                    {
                                        <dt class="col-6">Elektriciteit</dt>
                                        <dd class="col-6">@(v.ElektriciteitAmpere > 0 ? $"{v.ElektriciteitAmpere} A" : "Geen")</dd>
                                        <dt class="col-6">Ondergrond</dt>
                                        <dd class="col-6">@v.Ondergrond</dd>
                                        <dt class="col-6">Schaduw</dt>
                                        <dd class="col-6">@v.Schaduw</dd>
                                        <dt class="col-6">Wifi</dt>
                                        <dd class="col-6">@v.WifiDekking</dd>
                                    }
                                    @if (v.MaxVoertuigLengteMeters is not null)
                                    {
                                        <dt class="col-6">Max. voertuiglengte</dt>
                                        <dd class="col-6">@v.MaxVoertuigLengteMeters m</dd>
                                    }
                                    @if (v.MaxCaravanLengteMeters is not null)
                                    {
                                        <dt class="col-6">Max. caravanlengte</dt>
                                        <dd class="col-6">@v.MaxCaravanLengteMeters m</dd>
                                    }

                                    <dt class="col-6">Huisdieren</dt>
                                    <dd class="col-6">@(v.MaxHuisdieren > 0 ? $"Max. {v.MaxHuisdieren}" : "Niet toegestaan")</dd>
                                </dl>

                                @if (v.Voorzieningen.Count > 0)
                                {
                                    <ul class="list-unstyled d-flex flex-wrap gap-1 mb-0" aria-label="Voorzieningen">
                                        @foreach (var vz in v.Voorzieningen)
                                        {
                                            <li><span class="badge rounded-pill text-bg-light border">@vz.Naam</span></li>
                                        }
                                    </ul>
                                }
                            </div>
                            <div class="card-footer bg-transparent">
                                @if (v.PrijsPerNacht > 0)
                                {
                                    <strong>@((v.PrijsPerNacht * criteria.AantalNachten).ToString("C", nl))</strong>
                                    <span class="text-muted small">voor @criteria.AantalNachten nachten</span>
                                }
                                else
                                {
                                    <span class="text-muted">Prijs volgt</span>
                                }
                            </div>
                        </article>
                    </div>
                }
            </div>

            <Paginering Huidig="resultaten.PageNumber" AantalPaginas="resultaten.TotalPages" Url="PaginaUrl" />
        }
    }
}

@code {
    [SupplyParameterFromQuery] public string? Aankomst { get; set; }
    [SupplyParameterFromQuery] public string? Vertrek { get; set; }
    [SupplyParameterFromQuery] public int? Personen { get; set; }
    [SupplyParameterFromQuery] public string? Categorie { get; set; }
    [SupplyParameterFromQuery] public string? Type { get; set; }
    [SupplyParameterFromQuery] public int? Huisdieren { get; set; }

    [SupplyParameterFromQuery] public string? Voorzieningen { get; set; }

    [SupplyParameterFromQuery] public int? PageNumber { get; set; }
    [SupplyParameterFromQuery] public int? PageSize { get; set; }
    [SupplyParameterFromQuery(Name = "orderBy")] public string? OrderByWaarde { get; set; }
    [SupplyParameterFromQuery(Name = "orderType")] public string? OrderTypeWaarde { get; set; }

    private const string Placeholder = "images/placeholder-image.svg";

    private static readonly CultureInfo nl = CultureInfo.GetCultureInfo("nl-NL");

    private ZoekOptiesDto? opties;
    private string? optiesFout;

    private AccommodatieZoekCriteria? criteria;
    private PaginatedResult<AccommodatieDetailDto>? resultaten;
    private string? apiFout;
    private readonly List<string> fouten = new();

    protected override async Task OnInitializedAsync()
    {
        var antwoord = await ZoekService.GetZoekOptiesAsync();
        if (antwoord.Succeeded && antwoord.Value is not null)
            opties = antwoord.Value;
        else
            optiesFout = string.IsNullOrWhiteSpace(antwoord.Message) ? "onbekende fout." : antwoord.Message;
    }

    protected override async Task OnParametersSetAsync()
    {
        fouten.Clear();
        resultaten = null;
        apiFout = null;
        criteria = null;

        if (Aankomst is null && Vertrek is null && Personen is null)
            return;

        criteria = LeesCriteria();
        if (fouten.Count > 0)
            return;

        var antwoord = await ZoekService.ZoekAsync(criteria);
        if (antwoord.Succeeded)
            resultaten = antwoord.Value ?? new() { PageNumber = criteria.PageNumber, PageSize = criteria.PageSize };
        else
            apiFout = string.IsNullOrWhiteSpace(antwoord.Message) ? "onbekende fout." : antwoord.Message;
    }

    private AccommodatieZoekCriteria LeesCriteria()
    {
        var c = new AccommodatieZoekCriteria();

        if (!DateOnly.TryParseExact(Aankomst, "yyyy-MM-dd", out var aankomst))
            fouten.Add("Vul een geldige aankomstdatum in (jjjj-mm-dd).");
        else if (aankomst < DateOnly.FromDateTime(DateTime.Today))
            fouten.Add("De aankomstdatum mag niet in het verleden liggen.");
        c.Aankomst = aankomst;

        if (!DateOnly.TryParseExact(Vertrek, "yyyy-MM-dd", out var vertrek))
            fouten.Add("Vul een geldige vertrekdatum in (jjjj-mm-dd).");
        c.Vertrek = vertrek;

        if (aankomst != default && vertrek != default && vertrek <= aankomst)
            fouten.Add("De vertrekdatum moet na de aankomstdatum liggen.");

        if (Personen is null or < 1)
            fouten.Add("Vul het aantal personen in (minimaal 1).");
        c.Personen = Personen ?? 0;

        if (Huisdieren is < 0)
            fouten.Add("Het aantal huisdieren kan niet negatief zijn.");
        c.Huisdieren = Huisdieren ?? 0;

        c.Categorie = string.IsNullOrWhiteSpace(Categorie) ? null : Categorie;
        c.Type = string.IsNullOrWhiteSpace(Type) ? null : Type;
        c.Voorzieningen = string.IsNullOrWhiteSpace(Voorzieningen) ? null : Voorzieningen;

        if (PageNumber is < 1)
            fouten.Add("Het paginanummer moet minimaal 1 zijn.");
        c.PageNumber = PageNumber ?? 1;

        if (PageSize is < 1 or > PaginationBase.MaxPageSize)
            fouten.Add($"Kies tussen 1 en {PaginationBase.MaxPageSize} resultaten per pagina.");
        c.PageSize = PageSize ?? AccommodatieZoekCriteria.StandaardPageSize;

        if (OrderByWaarde is null)
            c.OrderBy = AccommodatieZoekCriteria.StandaardOrderBy;
        else if (Enum.TryParse<AccommodatieOrderBy>(OrderByWaarde, ignoreCase: true, out var orderBy) && Enum.IsDefined(orderBy))
            c.OrderBy = orderBy;
        else
            fouten.Add($"Op '{OrderByWaarde}' kan niet gesorteerd worden.");

        if (OrderTypeWaarde is null)
            c.OrderType = AccommodatieZoekCriteria.StandaardOrderType;
        else if (Enum.TryParse<OrderType>(OrderTypeWaarde, ignoreCase: true, out var orderType) && Enum.IsDefined(orderType))
            c.OrderType = orderType;
        else
            fouten.Add($"Onbekende sorteerrichting '{OrderTypeWaarde}'.");

        return c;
    }

    private string FormulierUrl => $"{Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0]}#zoekformulier";

    private string PaginaUrl(int pagina) =>
        criteria is null ? "zoekresultaten" : $"zoekresultaten?{criteria.MetPagina(pagina).ToQueryString()}";

    private static string SorteerWaarde(AccommodatieOrderBy orderBy, OrderType orderType) => $"{orderBy}:{orderType}";

    private static string Label(AccommodatieOrderBy orderBy) =>
        typeof(AccommodatieOrderBy).GetField(orderBy.ToString())?.GetCustomAttribute<DisplayAttribute>()?.GetName()
        ?? orderBy.ToString();

    private void SorteringGewijzigd(ChangeEventArgs e)
    {
        if (criteria is null || e.Value is not string waarde)
            return;

        var delen = waarde.Split(':');
        if (delen.Length == 2
            && Enum.TryParse<AccommodatieOrderBy>(delen[0], out var orderBy)
            && Enum.TryParse<OrderType>(delen[1], out var orderType))
        {
            Navigation.NavigateTo($"zoekresultaten?{criteria.MetSortering(orderBy, orderType).ToQueryString()}");
        }
    }

    private static string Datum(DateOnly d) => d.ToString("dddd d MMMM yyyy", nl);

    private string AfbeeldingUrl(string? pad) =>
        string.IsNullOrWhiteSpace(pad) || Http.BaseAddress is null
            ? Placeholder
            : new Uri(Http.BaseAddress, pad).ToString();
}
