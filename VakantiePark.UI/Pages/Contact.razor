@page "/contact"
@inject IParkService ParkService

<PageTitle>Contact | Vakantiepark D’r op Uut</PageTitle>
<HeadContent>
    <meta name="description" content="Neem contact op met de receptie van Vakantiepark D’r op Uut.">
</HeadContent>

<PageHeader Title="Contact" Intro="Vragen over je verblijf of een boeking? De receptie helpt je graag." />

<section class="section">
    <div class="container two-columns">
        <div class="contact-form">
            <h2>Stuur ons een bericht</h2>
            <EditForm class="form" Model="_message" OnValidSubmit="Send" FormName="contact">
                <DataAnnotationsValidator />
                <div class="field">
                    <label for="name">Naam</label>
                    <InputText id="name" @bind-Value="_message.Name" autocomplete="name" maxlength="@ContactMessage.NameMaxLength" />
                    <ValidationMessage For="() => _message.Name" />
                </div>
                <div class="field">
                    <label for="email">E-mailadres</label>
                    <InputText id="email" type="email" @bind-Value="_message.Email" autocomplete="email" maxlength="@ContactMessage.EmailMaxLength" />
                    <ValidationMessage For="() => _message.Email" />
                </div>
                <div class="field">
                    <label for="subject">Onderwerp</label>
                    <InputSelect id="subject" @bind-Value="_message.Subject">
                        @foreach (var subject in _subjects)
                        {
                            <option value="@subject">@subject</option>
                        }
                    </InputSelect>
                </div>
                <div class="field">
                    <label for="reservation-number">Reserveringsnummer <span class="field__hint">Alleen als je al geboekt hebt</span></label>
                    <InputText id="reservation-number" @bind-Value="_message.ReservationNumber" maxlength="@ContactMessage.ReservationNumberMaxLength" />
                </div>
                <div class="field">
                    <label for="message">Bericht</label>
                    <InputTextArea id="message" @bind-Value="_message.Message" maxlength="@ContactMessage.MessageMaxLength" />
                    <ValidationMessage For="() => _message.Message" />
                </div>
                <div><button class="button" type="submit">Verstuur bericht</button></div>
            </EditForm>
        </div>
        <address class="contact-details">
            <h2>Receptie</h2>
            @if (_park != null)
            {
                <dl>
                    <div><dt>Adres</dt><dd>@_park.Street<br>@_park.PostalCode @_park.City</dd></div>
                    <div><dt>Telefoon</dt><dd><a href="@Formatting.PhoneLink(_park.PhoneNumber)">@_park.PhoneNumber</a></dd></div>
                    <div><dt>E-mail</dt><dd><a href="mailto:@_park.Email">@_park.Email</a></dd></div>
                    <div>
                        <dt>Open</dt>
                        <dd>
                            @for (var i = 0; i < _park.ReceptionHours.Count; i++)
                            {
                                var hour = _park.ReceptionHours[i];
                                if (i > 0)
                                {
                                    <br>
                                }
                                @($"{hour.Label} {hour.Value}")
                            }
                        </dd>
                    </div>
                </dl>
            }
            else if (_parkError != null)
            {
                <p class="search-message" role="alert">De contactgegevens konden niet worden geladen: @_parkError</p>
            }
            else
            {
                <LoadingIndicator Text="Contactgegevens laden…" />
            }
            <p class="contact-details__note">Na sluitingstijd en bij nood bel je het noodnummer dat je bij aankomst krijgt.</p>
        </address>
    </div>
</section>

@code {
    private static readonly string[] _subjects =
    [
        "Vraag over een boeking",
        "Vraag over een accommodatie",
        "Zwembad",
        "Iets anders"
    ];

    private ContactMessage _message = new();
    private ParkInfoDto? _park;
    private string? _parkError;

    protected override async Task OnInitializedAsync()
    {
        var response = await ParkService.GetInfoAsync();
        if (response.Succeeded && response.Value != null)
        {
            _park = response.Value;
        }
        else
        {
            _parkError = string.IsNullOrWhiteSpace(response.Message) ? "onbekende fout." : response.Message;
        }
    }

    private void Send()
    {
        // TODO: Send the message to VakantiePark.API once the endpoint exists.
    }
}
